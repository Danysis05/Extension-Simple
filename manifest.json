{
  "manifest_version": 3,
  "name": "Capturador de Clics",
  "version": "1.0",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://pagosimple.com/"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://pagosimple.com/"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}