{
   "name" : "Logs Simple",
   "version": "1.0",
   "description": "Generador de seguimientos de usuarios mediante logs",
   "manifest_version": 3,

    "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "http://localhost:4200/*"
  ],
  
   "icons": {
        "16": "icons/logo.png"
   },
   "action": {
    "default_popup": "ui/index.html",
    "default_title": "Logs Simple"
   }
}   